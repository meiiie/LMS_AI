{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Wiii",
  "mainBinaryName": "Wiii Workbench",
  "version": "1.2.0",
  "identifier": "com.wiii-lab.wiii-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wiii",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "splashscreen",
        "title": "Wiii",
        "url": "splashscreen.html",
        "width": 480,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "focus": true,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "capabilities": [
        "splash",
        "workbench-base",
        "workbench-files",
        "workbench-network",
        "workbench-agents",
        "workbench-notifications"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://www.google.com https://wiii.holilihu.online",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https: ws://localhost:* ws://127.0.0.1:* wss:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "manifest-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "The Wiii Lab",
    "homepage": "https://wiii.holilihu.online",
    "license": "AGPL-3.0-only",
    "category": "DeveloperTool",
    "copyright": "Copyright \u00a9 2026 The Wiii Lab",
    "shortDescription": "Wiii \u2014 durable AI workbench by The Wiii Lab",
    "longDescription": "An open-source AI workbench for durable conversations, local and cloud agents, project files, tools, memory, artifacts, and permission-aware integrations.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "displayLanguageSelector": false,
        "languages": ["Vietnamese", "English"],
        "customLanguageFiles": {
          "Vietnamese": "windows/Vietnamese.nsh"
        },
        "compression": "lzma"
      }
    }
  }
}
